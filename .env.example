# Copy this file to .env and fill in the values. Never commit .env.

# --- Postgres (shared by the API and the bot) ---
POSTGRES_DB_HOST=db
POSTGRES_DB_PORT=5432
POSTGRES_DB_USERNAME=fazbots
POSTGRES_DB_PASSWORD=
POSTGRES_DB_DATABASE=fazbots

# --- API (NestJS) ---
PORT=3001
# Random string used to sign session cookies
COOKIE_SECRET=
# Where the dashboard is served (comma-separated if more than one)
FRONTEND_URL=http://localhost:8080

# Discord OAuth2 app (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/api/auth/redirect

# --- Bot (discord.js) ---
# Bot token from the Developer Portal > Bot
TOKEN=
# Address the bot uses to reach the API WebSocket
API_URL=http://api:3001

# Optional: Instagram account used by the influencer feed feature
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_FILE=./data/ig-session.json
